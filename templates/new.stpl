<!DOCTYPE html>
<html lang="uk" style="scrollbar-gutter: stable;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FlagEngine - New flag</title>
    <link rel="icon" href="data:,">
    <style>
        <% include!("styles.stpl"); %>

        form {
            max-width: 480px;
            margin-top: calc(var(--sub-h) / 2 - 7px);
        }

        label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        input[type="text"] {
            font-family: var(--font);
            font-size: 13px;
            box-sizing: border-box;
            width: 100%;
            padding: 8px 10px;
            border: 1px solid var(--ink);
            border-radius: 3px;
            outline: none;
            background: var(--bg);
            color: var(--ink);
        }

        input[type="text"]:focus {
            background: var(--surface-hover);
        }

        .hint {
            font-size: 11px;
            color: var(--muted);
            margin: 8px 0 0;
            line-height: 1.5;
        }

        .actions {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 20px;
        }

        .cancel {
            font-size: 11px;
            color: var(--ink);
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>New flag</h1>
        <a href="/admin" class="back">&larr; Flags</a>
    </div>

    <form method="POST" action="/admin/flags">
        <label for="key">Key</label>
        <input id="key" name="key" type="text" autofocus autocomplete="off" spellcheck="false">
        <p class="hint">
            1-64 characters: a-z, 0-9, ".", "_" and "-".<br>
            Must start and end with a letter or digit.<br>
            The key cannot be changed later and cannot be reused after archiving.
        </p>
        <div class="actions">
            <button type="submit" class="btn-primary">Create</button>
            <a href="/admin" class="cancel">Cancel</a>
        </div>
    </form>
</body>
</html>