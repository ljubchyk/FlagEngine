<!DOCTYPE html>
<html lang="uk" style="scrollbar-gutter: stable;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FlagEngine - <%= self.flag.key() %></title>
    <link rel="icon" href="data:,">
    <style>
        :root {
            --header-h: 28px;
            --sub-h: 32px;
        }

        body {
            font-family: monospace;
            color: #111;
            background: #fff;
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            /*margin-bottom: 8px;*/
            height: var(--header-h);
        }

        h1 {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .back {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: #111;
        }

        .meta {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 12px;
            /*padding-bottom: 12px;
            border-bottom: 1px solid #111;*/
            height: var(--sub-h);
            box-sizing: border-box;
            border-bottom: 1px solid #111;
            margin-bottom: 4px;
        }

        .meta .key {
            font-weight: 700;
        }

        .dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            margin-right: 6px;
            background: #ccc;
        }

        .dot.on { background: #111; }

        table {
            width: 100%;
            table-layout: fixed;
            border-collapse: collapse;
            font-size: 13px;
            text-align: left;
        }

        th, td {
            padding: 10px 0;
            border-bottom: 1px solid #e5e5e5;
        }

        th {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #595959;
        }

        th.time { width: 170px; }
        th.actor { width: 150px; }

        td.time, td.actor {
            font-size: 12px;
            color: #595959;
        }

        .section {
            margin: 28px 0 0;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #595959;
        }

        .actions {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-top: 16px;
        }

        .actions form {
            margin: 0;
        }

        .btn-primary {
            font-family: monospace;
            background: #111;
            color: #fff;
            padding: 6px 12px;
            border: 1px solid #111;
            border-radius: 3px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            cursor: pointer;
        }

        .btn-primary:hover {
            background: #fff;
            color: #111;
        }

        .btn-link {
            font-family: monospace;
            background: none;
            border: none;
            padding: 0;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: #111;
            text-decoration: underline;
            cursor: pointer;
        }

        .updated {
            margin-left: auto;
            font-size: 12px;
            color: #595959;
        }

        .more {
            display: inline-block;
            margin-top: 16px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: #111;
        }

        .empty {
            padding: 24px 0;
            font-size: 12px;
            color: #595959;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Flag</h1>
        <a href="/admin" class="back">&larr; Flags</a>
    </div>

    <div class="meta">
        <span class="key"><%= self.flag.key() %></span>
        <% if self.flag.is_archived() { %>
            <span>Archived</span>
        <% } else if self.flag.is_enabled() { %>
            <span><span class="dot on"></span>On</span>
        <% } else { %>
            <span><span class="dot"></span>Off</span>
        <% } %>
        <span class="updated">Updated <%= self.updated_at %> UTC</span>
    </div>

    <% if !self.flag.is_archived() { %>
        <div class="actions">
            <% if self.flag.is_enabled() { %>
                <form method="POST" action="/admin/flags/<%= self.flag.key() %>/disable?next=flag">
                    <button class="btn-primary">Turn off</button>
                </form>
            <% } else { %>
                <form method="POST" action="/admin/flags/<%= self.flag.key() %>/enable?next=flag">
                    <button class="btn-primary">Turn on</button>
                </form>
            <% } %>
            <form method="POST" action="/admin/flags/<%= self.flag.key() %>/archive?next=flag"
                  onsubmit="return confirm('Archive this flag? It cannot be restored and the key cannot be reused.')">
                <button class="btn-link">Archive</button>
            </form>
        </div>
    <% } %>

    <h2 class="section">History</h2>
    <% if self.events.is_empty() { %>
        <div class="empty">No events yet.</div>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th class="time">Time (UTC)</th>
                    <th class="actor">Actor</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% for event in &self.events { %>
                    <tr>
                        <td class="time"><%= event.created_at %></td>
                        <td class="actor"><%= event.actor %></td>
                        <td><%= event.action %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <% if self.has_more { %>
            <a class="more" href="/admin/flags/<%= self.flag.key() %>/audit">All history &rarr;</a>
        <% } %>
    <% } %>
</body>
</html>
