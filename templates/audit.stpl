<!DOCTYPE html>
<html lang="uk" style="scrollbar-gutter: stable;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FlagEngine - History</title>
    <link rel="icon" href="data:,">
    <style>
        <% include!("styles.stpl"); %>
    </style>
</head>
<body>
    <div class="header">
        <h1>History</h1>
        <a href="/admin/flags/<%= self.flag.key() %>" class="back">&larr; Flag</a>
    </div>

    <div class="meta">
        <span class="key"><%= self.flag.key() %></span>
        <% if self.flag.is_archived() { %>
            <span>Archived</span>
        <% } else if self.flag.is_enabled() { %>
            <span><span class="dot on"></span>On</span>
        <% } else { %>
            <span><span class="dot"></span>Off</span>
        <% } %>
    </div>

    <% if self.events.is_empty() { %>
        <div class="empty">No events yet.</div>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th class="time">Time (UTC)</th>
                    <th class="actor">Actor</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% for event in &self.events { %>
                    <tr>
                        <td class="time"><%= event.created_at %></td>
                        <td class="actor"><%= event.actor %></td>
                        <td><%= event.action %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <% if let Some(before) = self.next_before { %>
            <a class="more" href="/admin/flags/<%= self.flag.key() %>/audit?before=<%= before %>">Older &rarr;</a>
        <% } %>
    <% } %>
</body>
</html>