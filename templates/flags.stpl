<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<title>FlagEngine</title>
<link rel="icon" href="data:,">
<style>
  body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; }
  table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  th, td { text-align: left; padding: .5rem; border-bottom: 1px solid #ddd; }
  form { display: inline; }
  .on { color: #1a7f37; } .off { color: #666; } .archived { opacity: .5; }
  nav a { margin-right: 1rem; } nav a.current { font-weight: bold; }
</style>
</head>
<body>
<h1>FlagEngine</h1>

<nav>
  <a href="/admin?status=active"<% if self.status == "active" { %> class="current"<% } %>>Активні</a>
  <a href="/admin?status=archived"<% if self.status == "archived" { %> class="current"<% } %>>Архівні</a>
  <a href="/admin?status=all"<% if self.status == "all" { %> class="current"<% } %>>Усі</a>
</nav>

<form method="post" action="/admin/flags">
  <input name="key" placeholder="new-flag-key" required maxlength="64" autofocus>
  <button>Створити</button>
</form>

<% if self.flags.is_empty() { %>
  <p>Флагів немає.</p>
<% } else { %>
  <table>
    <tr><th>Ключ</th><th>Стан</th><th>Оновлено (unix ms)</th><th></th></tr>
    <% for flag in &self.flags { %>
      <tr<% if flag.is_archived() { %> class="archived"<% } %>>
        <td><%= flag.key() %></td>
        <td><% if flag.is_enabled() { %><span class="on">увімкнено</span><% } else { %><span class="off">вимкнено</span><% } %></td>
        <td><%= flag.updated_at() %></td>
        <td>
          <% if !flag.is_archived() { %>
            <% if flag.is_enabled() { %>
              <form method="post" action="/admin/flags/<%= flag.key() %>/disable"><button>Вимкнути</button></form>
            <% } else { %>
              <form method="post" action="/admin/flags/<%= flag.key() %>/enable"><button>Увімкнути</button></form>
            <% } %>
            <form method="post" action="/admin/flags/<%= flag.key() %>/archive"><button>Архівувати</button></form>
          <% } %>
        </td>
      </tr>
    <% } %>
  </table>
<% } %>
</body>
</html>