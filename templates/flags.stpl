<!DOCTYPE html>
<html lang="uk" style="scrollbar-gutter: stable;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FlagEngine - Flags</title>
    <link rel="icon" href="data:,">
    <style>
        <% include!("styles.stpl"); %>

        .toolbar {
            display: flex;
            align-items: center;
            gap: 16px;
            border-bottom: 1px solid var(--ink);
            height: var(--sub-h);
            box-sizing: border-box;
            margin-bottom: 4px;
        }

        .tab {
            font-family: var(--font);
            font-size: 11px;
            font-weight: 400;
            text-transform: uppercase;
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            cursor: pointer;
            color: var(--muted);
            align-self: stretch;
            padding: 0;
        }

        .tab:hover {
            color: var(--ink);
            font-weight: 600;
        }

        .tab.active {
            font-weight: 600;
            border-bottom-color: var(--ink);
            color: var(--ink);
        }

        .divider {
            width: 1px;
            height: 16px;
            background: var(--divider);
        }

        .search {
            font-family: var(--font);
            font-size: 12px;
            flex: 1;
            border: none;
            outline: none;
            background: none;
            color: var(--ink);
            align-self: stretch;
            padding: 0;
        }

        .search::placeholder {
            color: var(--muted);
        }

        .col-status { width: 90px; }
        .col-updated { width: 150px; }
        .col-actions { width: 150px; text-align: right; }

        .cell-actions { text-align: right; }

        .cell-key {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .flag-key {
            font-size: 12px;
            color: var(--ink);
            text-decoration: none;
            border-bottom: 1px dotted var(--muted);
        }

        .flag-key:hover {
            border-bottom: 1px solid var(--ink);
        }

        .flag-key.archived {
            color: var(--muted);
            text-decoration: line-through;
            border-bottom: none;
        }

        .flag-key.archived:hover {
            color: var(--ink);
        }

        .cell-status {
            font-size: 12px;
        }

        .cell-updated {
            font-size: 12px;
            color: var(--muted);
        }

        .flag-action-form {
            display: inline;
            margin-left: 12px;
        }

        .flag-action-button {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 11px;
            font-family: inherit;
            color: var(--ink);
            padding: 0;
            text-decoration: underline;
        }

        .flag-action-button:hover {
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Flags</h1>
        <a href="/admin/flags/new" class="btn-primary">+ New Flag</a>
    </div>

    <div class="toolbar">
        <button class="tab active" data-tab data-status="0">Active</button>
        <button class="tab" data-tab data-status="1">Archived</button>
        <button class="tab" data-tab data-status="2">All</button>
        <span class="divider"></span>
        <input id="q" type="search" class="search" placeholder="Search by key..." autocomplete="off" spellcheck="false">
    </div>

    <table>
        <thead>
            <tr>
                <th>Key</th>
                <th class="col-status">Status</th>
                <th class="col-updated">Updated (UTC)</th>
                <th class="col-actions">Action</th>
            </tr>
        </thead>
        <tbody>
            <% for row in &self.rows { %>
                <tr data-key="<%= row.key() %>"
                    data-status="<%= row.filter() %>"
                    <% if row.is_archived() { %>hidden<% } %>>
                    <td class="cell-key">
                        <a class="flag-key <%= row.status_modifier() %>" href="/admin/flags/<%= row.key() %>"><%= row.key() %></a>
                    </td>
                    <td class="cell-status">
                        <span class="dot <%= row.status_modifier() %>"></span><%= row.status_label() %>
                    </td>
                    <td class="cell-updated"><%= row.updated_at %></td>
                    <td class="cell-actions">
                        <% if row.can_enable() { %>
                            <form class="flag-action-form" method="POST" action="/admin/flags/<%= row.key() %>/enable"><button class="flag-action-button">turn on</button></form>
                        <% } %>
                        <% if row.can_disable() { %>
                            <form class="flag-action-form" method="POST" action="/admin/flags/<%= row.key() %>/disable"><button class="flag-action-button">turn off</button></form>
                        <% } %>
                        <% if row.can_archive() { %>
                            <form class="flag-action-form" method="POST" action="/admin/flags/<%= row.key() %>/archive"
                                onsubmit="return confirm('Archive this flag? It cannot be restored and the key cannot be reused.')"><button class="flag-action-button">archive</button></form>
                        <% } %>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
    <div class="empty" id="empty" hidden>No flags found.</div>

    <script>
        const q = document.getElementById("q");
        const tabs = document.querySelectorAll("[data-tab]");
        const rows = document.querySelectorAll("tr[data-key]");
        const empty = document.getElementById("empty");
        let status = "0";

        function filter() {
            const text = q.value.trim().toLowerCase();
            let shown = 0;
            for (const row of rows) {
                const byStatus = status === "2" || row.dataset.status === status;
                const byKey = row.dataset.key.includes(text);
                row.hidden = !(byStatus && byKey);
                if (!row.hidden) shown++;
            }
            empty.hidden = shown !== 0;
        }

        for (const t of tabs) {
            t.onclick = () => {
                status = t.dataset.status;
                for (const x of tabs) x.classList.toggle("active", x.dataset.status === status);
                filter();
            };
        }

        q.oninput = filter;
        q.value = "";
        filter();
    </script>
</body>
</html>