<!DOCTYPE html>
<html lang="uk" style="scrollbar-gutter: stable;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FlagEngine - Flags</title>
    <link rel="icon" href="data:,">
    <style>
        <% include!("styles.stpl"); %>

        .toolbar {
            display: flex;
            align-items: center;
            gap: 16px;
            border-bottom: 1px solid var(--ink);
            height: var(--sub-h);
            box-sizing: border-box;
            margin-bottom: 4px;
        }

        .tab {
            font-family: var(--font);
            font-size: 11px;
            font-weight: 400;
            text-transform: uppercase;
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            cursor: pointer;
            color: var(--muted);
            align-self: stretch;
            padding: 0;
        }

        .tab:hover {
            color: var(--ink);
            font-weight: 600;
        }

        .tab.active {
            color: var(--ink);
            font-weight: 600;
            border-bottom-color: var(--ink);
        }

        .divider {
            width: 1px;
            height: 16px;
            background: var(--divider);
        }

        .search {
            font-family: var(--font);
            font-size: 12px;
            flex: 1;
            border: none;
            outline: none;
            background: none;
            color: var(--ink);
            align-self: stretch;
            padding: 0;
        }

        .search::placeholder {
            color: var(--muted);
        }

        th.status { width: 90px; }
        th.updated { width: 150px; }
        th.actions { width: 150px; text-align: right; }
        td.actions { text-align: right; }

        td.key {
            font-size: 12px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        td.key a {
            color: var(--ink);
            text-decoration: none;
            border-bottom: 1px dotted var(--muted);
        }

        td.key a:hover {
            border-bottom: 1px solid var(--ink);
        }

        td.key.archived a {
            color: var(--muted);
            text-decoration: line-through;
            border-bottom: none;
        }

        td.key.archived a:hover {
            color: var(--ink);
        }

        td.status {
            font-size: 12px;
        }

        td.updated {
            font-size: 12px;
            color: var(--muted);
        }

        td.actions form {
            display: inline;
            margin-left: 12px;
        }

        td.actions button {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 11px;
            font-family: inherit;
            color: var(--ink);
            padding: 0;
            text-decoration: underline;
        }

        td.actions button:hover {
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Flags</h1>
        <a href="/admin/flags/new" class="btn-primary">+ New Flag</a>
    </div>

    <div class="toolbar">
        <button class="tab active" data-status="0">Active</button>
        <button class="tab" data-status="1">Archived</button>
        <button class="tab" data-status="2">All</button>
        <span class="divider"></span>
        <input id="q" type="search" class="search" placeholder="Search by key..." autocomplete="off" spellcheck="false">
    </div>

    <table>
        <thead>
            <tr>
                <th>Key</th>
                <th class="status">Status</th>
                <th class="updated">Updated (UTC)</th>
                <th class="actions">Action</th>
            </tr>
        </thead>
        <tbody>
            <% for flag in &self.flags { %>
                <tr data-key="<%= flag.key %>" <% if flag.archived { %>data-status="1" hidden<% } else { %>data-status="0"<% } %>>
                    <td class="key<% if flag.archived { %> archived<% } %>">
                        <a href="/admin/flags/<%= flag.key %>"><%= flag.key %></a>
                    </td>
                    <td class="status">
                        <% if flag.archived { %>
                            Archived
                        <% } else if flag.enabled { %>
                            <span class="dot on"></span>On
                        <% } else { %>
                            <span class="dot"></span>Off
                        <% } %>
                    </td>
                    <td class="updated"><%= flag.updated_at %></td>
                    <td class="actions">
                        <% if !flag.archived { %>
                            <% if flag.enabled { %>
                                <form method="POST" action="/admin/flags/<%= flag.key %>/disable"><button>turn off</button></form>
                            <% } else { %>
                                <form method="POST" action="/admin/flags/<%= flag.key %>/enable"><button>turn on</button></form>
                            <% } %>
                            <form method="POST" action="/admin/flags/<%= flag.key %>/archive"
                                onsubmit="return confirm('Archive this flag? It cannot be restored and the key cannot be reused.')"><button>archive</button></form>
                        <% } %>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
    <div class="empty" id="empty" hidden>No flags found.</div>

    <script>
        const q = document.getElementById("q");
        const tabs = document.querySelectorAll(".tab");
        const rows = document.querySelectorAll("tr[data-key]");
        const empty = document.getElementById("empty");
        let status = "0";

        function filter() {
            const text = q.value.trim().toLowerCase();
            let shown = 0;
            for (const row of rows) {
                const byStatus = status === "2" || row.dataset.status === status;
                const byKey = row.dataset.key.includes(text);
                row.hidden = !(byStatus && byKey);
                if (!row.hidden) shown++;
            }
            empty.hidden = shown !== 0;
        }

        for (const t of tabs) {
            t.onclick = () => {
                status = t.dataset.status;
                for (const x of tabs) x.classList.toggle("active", x.dataset.status === status);
                filter();
            };
        }

        q.oninput = filter;
        q.value = "";
        filter();
    </script>
</body>
</html>